    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "@tailwindcss/cli": "^4.3.5",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "playwright": "^1.65.1"
  }
}
