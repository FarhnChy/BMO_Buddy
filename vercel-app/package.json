{
  "name": "bmo-fridge-buddy-vercel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "esbuild ui/entry.tsx --bundle --minify --outfile=public/magic-ui.js && tailwindcss -i ui/magic.css -o public/magic-ui.css --minify && node scripts/check.mjs",
